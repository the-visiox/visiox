# Copy to `.env` and adjust.
# Host machine (python manage.py on your PC): DATABASE_HOST=localhost
# Docker Compose service name `db` only works inside containers.

DATABASE_NAME=visiox_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
# 5433 = default host port mapped from docker-compose `db`; use 5432 for native Postgres
DATABASE_PORT=5433

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional: comma-separated origins for visiox-ui (e.g. http://192.168.1.10:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional vector DB (if features use it)
VECTOR_DATABASE_NAME=visiox_vector_db
VECTOR_DATABASE_USER=postgres
VECTOR_DATABASE_PASSWORD=postgres
VECTOR_DATABASE_HOST=localhost
VECTOR_DATABASE_PORT=5432
