# =========================================================
# Shared infrastructure — point to the shared server
# Run docker-compose.infra.yml on that server first
# =========================================================

# PostgreSQL (shared server)
DATABASE_NAME=visiox_db
DATABASE_USER=postgres
DATABASE_PASSWORD=<DATABASE_PASSWORD>
DATABASE_HOST=10.29.30.20
DATABASE_PORT=5432

# Redis (shared server)
CELERY_BROKER_URL=redis://10.29.30.20:6379/0
CELERY_RESULT_BACKEND=redis://10.29.30.20:6379/0
# Run dataset imports, augmentation, and cache work on Celery workers.
USE_CELERY=True
AUTO_LABEL_USE_CELERY=False
# Bounded storage concurrency for dataset imports (restart worker after changing).
DATASET_IMPORT_STORAGE_WORKERS=6
DATASET_IMPORT_BATCH_SIZE=24
DATASET_DIRECT_UPLOAD_EXPIRES=3600
# Reuse DB connections across requests (seconds). Use PgBouncer in front at scale.
DATABASE_CONN_MAX_AGE=60

# MinIO (shared server)
USE_MINIO=True
MINIO_ENDPOINT=http://10.29.30.20:9000
MINIO_ACCESS_KEY=<MINIO_SERVICE_ACCOUNT>
MINIO_SECRET_KEY=<MINIO_SERVICE_ACCOUNT_SECRET>
MINIO_BUCKET=visiox-media

# GPU training agent (FastAPI on the GPU server)
TRAINING_AGENT_URL=http://192.168.210.26:8002
TRAINING_AGENT_TOKEN=
TRAINING_CALLBACK_TOKEN=<SHARED_CALLBACK_TOKEN>
# This value is embedded into each training job request at dispatch time.
# Restart the Django API and Celery worker after changing it, then create a new job.
# Use a URL the GPU runtime can actually reach: LAN IP for direct access or 127.0.0.1:18080 only when the
# agent runs on the GPU host itself and an SSH reverse tunnel is active there.
TRAINING_CALLBACK_BASE_URL=http://10.29.30.9:8000
TRAINING_AGENT_TIMEOUT=30
TRAINING_LABEL_DELIVERY=minio
TRAINING_LABEL_SOURCE=minio
TRAINING_AGENT_MINIO_ENDPOINT=
INFERENCE_API_URL=http://192.168.210.26:8003
INFERENCE_AGENT_TOKEN=

# =========================================================
# App settings — configure per developer / environment
# =========================================================

SECRET_KEY=<DJANGO_SECRET_KEY>
DEBUG=True
ENABLE_SILK=false

# Allow access from any host in development
# Production: set to your actual domain e.g. api.visiox.com
ALLOWED_HOSTS=*

# CORS: add your frontend URL
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000

# =========================================================
# OAuth (optional)
# =========================================================

# Google redirect URI: http://localhost:3000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub callback URL: http://localhost:3000/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# =========================================================
# Email / SMTP (optional)
# =========================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=visiox@gmail.com
